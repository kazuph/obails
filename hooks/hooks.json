{
  "description": "Auto-build ob CLI binary if not found in PATH",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "which ob > /dev/null 2>&1 || (cd \"${CLAUDE_PLUGIN_ROOT}\" && go build -tags cli -o /usr/local/bin/ob ./cmd/cli 2>&1)",
            "statusMessage": "Checking ob CLI binary...",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
